  m_Script: {fileID: 11500000, guid: 02376f25e1abb9c4e84f5007f2f3fecf, type: 3}
  m_Name: Q01_MultipleChoice
  m_EditorClassIdentifier: 
  id: Q01_MultipleChoice
  type: 0
  questionText: 'Lagi scroll TikTok, muncul video pendek soal demo, disusul video
    pejabat dengan latar belakang acara meriah, diberi caption : "Rakyat diserbu
    gas air mata, pejabatnya asyik pesta!". Setelah ditelusuri, video tersebut ternyata
    dokumentasi acara dua tahun lalu, bukan bersamaan dengan demo. Kasus ini masuk
    kategori?'
  correctExplanation: Tepat banget! Ini malinformasi karena videonya asli, tapi sengaja
    diubah konteksnya untuk memicu emosi publik dan pecah belah rakyat.
  incorrectExplanation: Masih kegocek nih! Videonya asli, tapi diubah konteksnya
    secara sengaja untuk menyerang/ngerusak reputasi. Itu definisi malinformasi.
  options:
  - Misinformasi
  - Disinformasi
  - Malinformasi
  - Satir
  correctAnswerIndex: 2
